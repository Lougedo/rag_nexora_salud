      "name": "Leer PDF",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        1040,
        224
      ],
      "parameters": {
        "dataType": "binary",
        "binaryMode": "allInputData",
        "loader": "pdfLoader",
        "textSplittingMode": "custom",
        "options": {
          "splitPages": true,
          "metadata": {
            "metadataValues": [
              {
                "name": "doc_id",
                "value": "={{ $('Documento recibido').item.json.id }}"
              },
