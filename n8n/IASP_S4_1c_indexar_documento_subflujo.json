      }
    },
    {
      "id": "cf9d6983-f173-42b0-bb23-f8684ac43108",
      "name": "Descargar el PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        416
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "pdf"
            }
          },
          "timeout": 180000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "fe05f173-8450-4c7e-8152-58a1b1190a2f",
      "name": "Marcar como PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        416
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// GitHub entrega los PDF como \"application/octet-stream\"; el lector solo acepta \"application/pdf\".\nreturn $input.all().map((item) => {\n  const pdf = item.binary?.pdf;\n  if (pdf) pdf.mimeType = 'application/pdf';\n  return {\n    json: { ...item.json, tiene_pdf: Boolean(pdf) && !item.json.error },\n    binary: item.binary,\n    pairedItem: item.pairedItem,\n  };\n});"
      }
    },
    {
      "id": "18af19c7-5372-4759-a23c-f967e32caf0d",
      "name": "¿Se descargó?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        672,
        416
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.tiene_pdf }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "912837e3-e33b-4529-9704-5824e674412d",
      "name": "Guardar en Qdrant",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [
        896,
