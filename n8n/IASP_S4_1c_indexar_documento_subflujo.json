                "value": "={{ $('Documento recibido').item.json.fuente }}"
              }
            ]
          }
        }
      }
    },
    {
      "id": "ead952a4-bd1e-4a30-b1e5-71215df75bdf",
      "name": "Trocear (1.000 / 200)",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        1040,
        432
      ],
      "parameters": {
        "chunkSize": 1000,
        "chunkOverlap": 200
      }
    },
    {
      "id": "880234dc-799e-4d5e-b696-9893c9efd6c1",
      "name": "Contar trozos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        208
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Devuelve solo el recuento: los trozos ya están en Qdrant.\nconst d = $('Documento recibido').first().json;\nconst items = $input.all();\nconst trozos = items.filter((i) => i.json.pageContent !== undefined).length;\nconst fallo = items.find((i) => i.json.error)?.json.error;\n\nreturn [{ json: {\n  id: d.id,\n  titulo: d.titulo,\n  capa: d.capa,\n  trozos,\n  error: trozos ? '' : (fallo ? String(fallo.message ?? fallo).slice(0, 200) : 'No se guardó ningún trozo (¿PDF sin texto?)'),\n} }];"
      }
    },
    {
      "id": "b1ab835f-dc1e-4c71-b4a2-42201d6dcbda",
      "name": "Sin PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        608
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const d = $('Documento recibido').first().json;\nreturn [{ json: { id: d.id, titulo: d.titulo, capa: d.capa, trozos: 0, error: 'No se pudo descargar el PDF' } }];"
      }
    },
    {
      "id": "4ed370db-0f39-4cf5-8e5b-c2edd5f5eaf0",
      "name": "Sticky Note f302fa38",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        560,
        608
      ],
      "parameters": {
        "content": "## Un documento cada vez\nLo llama el flujo **1b**. Cada documento se procesa en su propia ejecución para que n8n libere la memoria al terminar.\n\nDevuelve solo el número de trozos guardados en la colección `nexora_guias` de Qdrant.",
        "color": 7
      }
    }
  ],
