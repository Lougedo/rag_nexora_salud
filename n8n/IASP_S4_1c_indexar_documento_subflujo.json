        },
        "embeddingBatchSize": 200
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "342ab696-3e66-446a-a354-4d66c96873c5",
      "name": "OpenAI · Embeddings (1.536 números)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
